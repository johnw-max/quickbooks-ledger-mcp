NODE_ENV=development
QUICKBOOKS_HOST=127.0.0.1
QUICKBOOKS_PORT=3010
QUICKBOOKS_PUBLIC_BASE_URL=http://127.0.0.1:3010
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/accounting_mcp

# Generate independent random values. Never reuse the Xero keys.
QUICKBOOKS_MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
QUICKBOOKS_TOKEN_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-byte-key
QUICKBOOKS_MCP_ALLOWED_ORIGINS=https://agent2.zcloak.ai
QUICKBOOKS_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
QUICKBOOKS_REQUEST_BODY_LIMIT_BYTES=1048576
# Every ledger read/prepare must use a short-lived opaque exact-Company target.
QUICKBOOKS_TARGET_SESSION_TTL_SECONDS=900

# Optional host-facing OAuth. Enable this to let each Agent2 installation
# authorize its own QuickBooks company instead of sharing the demo actor.
QUICKBOOKS_MCP_OAUTH_ENABLED=false
QUICKBOOKS_MCP_OAUTH_CLIENT_ID=agent2-quickbooks-accounting-mcp
QUICKBOOKS_MCP_OAUTH_CLIENT_SECRET=replace-with-at-least-32-random-characters
QUICKBOOKS_MCP_OAUTH_REDIRECT_URIS=https://agent2.zcloak.ai/api/mcp/quickbooks-accounting-mcp/oauth/callback
QUICKBOOKS_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
QUICKBOOKS_MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

QUICKBOOKS_CLIENT_ID=replace-from-intuit-developer-app
QUICKBOOKS_CLIENT_SECRET=replace-from-intuit-developer-app
QUICKBOOKS_ENVIRONMENT=sandbox
# Leave unset to let Intuit use its current default minor version.
# QUICKBOOKS_MINOR_VERSION=75

# Safe default: prepare/review works, but approval cannot write to QBO.
QUICKBOOKS_WRITE_ENABLED=false
# Required only when QUICKBOOKS_WRITE_ENABLED=true.
# QUICKBOOKS_ALLOWED_REALM_ID=123456789012345
# Optional static release subset. The Accounting Case compiler currently exposes
# only CREATE Customer, Vendor, Invoice, Bill, CreditMemo, and VendorCredit.
# QUICKBOOKS_ALLOWED_WRITE_CAPABILITIES=CREATE:Customer,CREATE:Vendor,CREATE:Invoice,CREATE:Bill,CREATE:CreditMemo,CREATE:VendorCredit

# Standing delegation is the Agent authority gate for Case execution. Enabling
# it without an explicit released action list is a startup error.
QUICKBOOKS_STANDING_DELEGATION_ENABLED=false
# QUICKBOOKS_STANDING_DELEGATION_ACTIONS=customer.create_basic,vendor.create_basic,invoice.create,bill.create,credit_memo.create,vendor_credit.create

QUICKBOOKS_DEMO_ACTOR_ID=quickbooks-demo-operator
QUICKBOOKS_LOG_LEVEL=info
