COMPOSE_PROJECT_NAME=quickbooks-ledger-mcp
QUICKBOOKS_APP_IMAGE=quickbooks-ledger-mcp:0.6.0
QUICKBOOKS_LOOPBACK_PORT=18003
QUICKBOOKS_EGRESS_NETWORK=REPLACE_WITH_EGRESS_NETWORK
QUICKBOOKS_DATA_NETWORK=REPLACE_WITH_DATA_NETWORK

NODE_ENV=production
QUICKBOOKS_HOST=0.0.0.0
QUICKBOOKS_PORT=3000
QUICKBOOKS_PUBLIC_BASE_URL=https://mcp.jiayuanwang.xyz
DATABASE_URL=postgresql://REPLACE_WITH_DATABASE_URL
QUICKBOOKS_MCP_BEARER_TOKEN=REPLACE_WITH_INDEPENDENT_32_CHAR_TOKEN
QUICKBOOKS_MCP_ALLOWED_ORIGINS=https://agent2.zcloak.ai,https://mcp.jiayuanwang.xyz
QUICKBOOKS_MCP_ALLOWED_HOSTS=mcp.jiayuanwang.xyz
QUICKBOOKS_REQUEST_BODY_LIMIT_BYTES=1048576
QUICKBOOKS_TARGET_SESSION_TTL_SECONDS=900

QUICKBOOKS_MCP_OAUTH_ENABLED=true
QUICKBOOKS_MCP_OAUTH_CLIENT_ID=agent2-quickbooks-accounting-mcp
QUICKBOOKS_MCP_OAUTH_CLIENT_SECRET=REPLACE_WITH_INDEPENDENT_32_CHAR_SECRET
QUICKBOOKS_MCP_OAUTH_REDIRECT_URIS=https://agent2.zcloak.ai/api/mcp/quickbooks-accounting-mcp/oauth/callback
QUICKBOOKS_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
QUICKBOOKS_MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

QUICKBOOKS_CLIENT_ID=REPLACE_WITH_INTUIT_CLIENT_ID
QUICKBOOKS_CLIENT_SECRET=REPLACE_WITH_INTUIT_CLIENT_SECRET
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_MINOR_VERSION=
QUICKBOOKS_TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_DISTINCT_32_BYTE_BASE64_KEY

QUICKBOOKS_WRITE_ENABLED=false
QUICKBOOKS_WRITE_TARGET_MODE=exact_allowlist
QUICKBOOKS_ALLOWED_REALM_ID=REPLACE_WITH_CONTROLLED_SANDBOX_REALM_ID
QUICKBOOKS_ALLOWED_WRITE_CAPABILITIES=CREATE:Customer,CREATE:Vendor,CREATE:Invoice,CREATE:Bill,CREATE:CreditMemo,CREATE:VendorCredit
QUICKBOOKS_STANDING_DELEGATION_ENABLED=false
QUICKBOOKS_STANDING_DELEGATION_ACTIONS=customer.create_basic,vendor.create_basic,invoice.create,bill.create,credit_memo.create,vendor_credit.create
QUICKBOOKS_RESTRICTED_REVIEWER_ACTORS=
QUICKBOOKS_DEMO_ACTOR_ID=quickbooks-agent2-test
QUICKBOOKS_LOG_LEVEL=info
