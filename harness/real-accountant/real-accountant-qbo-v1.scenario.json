{
  "$schema": "./scenario.schema.json",
  "schemaVersion": "qbo-real-accountant-uat/v1",
  "packId": "qbo-real-accountant-sg-july-2026-v1",
  "title": "去标识化真实会计习惯 QuickBooks 连续对话 UAT",
  "description": "用 14 份纯虚构测试材料和 16 轮连续自然语言对话，验证 QuickBooks MCP 的读取、跨账本翻译、事实更正、受控写入、幂等与精确回读。",
  "sourceProvenance": {
    "sourceType": "SYNTHETIC_ACCOUNTING_TEST_PACK",
    "allBusinessNamesAndIdentifiersAreFictitious": true,
    "originalFilesCommitted": false,
    "derivedFromColleagueConversationStyle": true,
    "colleagueIdentityOrMetadataIncluded": false
  },
  "privacyBoundary": {
    "committedMaterial": [
      "logical artifact IDs",
      "fictitious document facts needed by the oracle",
      "SHA-256 environment placeholders",
      "sanitized natural-language turns"
    ],
    "prohibitedMaterial": [
      "original DOCX or Markdown exports",
      "internal Agent, Workspace, tenant or conversation IDs",
      "internal Drive URLs",
      "real colleague names, emails or document author metadata",
      "OAuth tokens, cookies or QuickBooks credentials"
    ]
  },
  "target": {
    "provider": "quickbooks",
    "ledgerRole": "FORMAL_SYSTEM_OF_RECORD",
    "environment": "QUICKBOOKS_SANDBOX_ONLY",
    "mcpEndpoint": "https://mcp.jiayuanwang.xyz/quickbooks/mcp",
    "onlineHost": {
      "name": "Work",
      "baseUrl": "https://work.zcloak.ai",
      "modelDisplayName": "DeepSeek V4",
      "modelId": "LIVE_VERIFY_IN_WORK_MODEL_SELECTOR"
    },
    "mcpIsolation": {
      "quickBooksAndXeroAreSeparateMcps": true,
      "requiredToolPrefix": "quickbooks_",
      "forbiddenToolPrefixes": [
        "xero_"
      ],
      "forbiddenLegacyToolsInAccountingCaseMode": [
        "quickbooks_hash_source_document",
        "quickbooks_prepare_supplier_bill",
        "quickbooks_prepare_mutation",
        "quickbooks_execute_confirmed_mutation"
      ]
    }
  },
  "actor": {
    "role": "ACCOUNTING_FIRM_ACCOUNTANT",
    "interactionStyle": [
      "short natural business prompts",
      "Chinese and English mixed",
      "occasional typos",
      "long-running conversation references such as 上述, 图7 and 文件A",
      "uploads arrive in more than one batch",
      "expects global correction rather than local patching",
      "does not name MCP tools"
    ]
  },
  "startingConditions": {
    "oauth": "OAUTH_BOUND_TO_THE_CURRENT_WORK_INSTALLATION_AND_ONE_SANDBOX_COMPANY",
    "homeCurrency": "SGD",
    "sandboxOnly": true,
    "requiredScopes": [
      "quickbooks.read",
      "quickbooks.mutation.prepare",
      "quickbooks.mutation.execute"
    ],
    "requiredStandingDelegationActions": [
      "customer.create_basic",
      "vendor.create_basic",
      "invoice.create",
      "bill.create",
      "credit_memo.create",
      "vendor_credit.create"
    ],
    "freshDataGate": {
      "exactContactNamesMustNotExist": [
        "Lion City Digital Pte. Ltd.",
        "OfficeHub Singapore Pte. Ltd."
      ],
      "documentNumbersMustNotExist": [
        "INV-2026-0702",
        "OH-260701",
        "CN-2026-0001",
        "OH-CN-260722"
      ],
      "dirtyBaselineResult": "BLOCKED_TEST_DATA_DIRTY",
      "destructiveCleanupAllowed": false
    },
    "quickBooksReferencePlaceholders": {
      "consultingItemName": "{{QBO_CONSULTING_ITEM_NAME}}",
      "officeExpensesAccountName": "{{QBO_OFFICE_EXPENSES_ACCOUNT_NAME}}",
      "salesGst9TaxCodeName": "{{QBO_SALES_GST_9_TAX_CODE_NAME}}",
      "purchasesGst9TaxCodeName": "{{QBO_PURCHASES_GST_9_TAX_CODE_NAME}}"
    }
  },
  "globalToolOracle": {
    "requiredReadBeforeWrite": [
      "quickbooks_connection_status",
      "quickbooks_resolve_target",
      "quickbooks_get_company",
      "quickbooks_search_customers",
      "quickbooks_search_vendors",
      "quickbooks_list_items",
      "quickbooks_list_accounts",
      "quickbooks_list_tax_codes"
    ],
    "onlyReleasedWriteTools": [
      "quickbooks_prepare_accounting_case",
      "quickbooks_execute_accounting_case",
      "quickbooks_get_accounting_case_status"
    ],
    "neverAllowed": [
      "any xero_* tool",
      "a legacy supplier-bill shortcut while Accounting Case mode is enabled",
      "a generic mutation shortcut while Accounting Case mode is enabled",
      "a write to a production QuickBooks Company",
      "a blind retry after WRITE_RESULT_UNKNOWN or READBACK_MISMATCH"
    ]
  },
