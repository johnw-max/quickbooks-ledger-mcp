  "cases": [
    {
      "caseId": "QBO-RA-E2E-01",
      "title": "14 份材料、16 轮连续真实会计对话",
      "purpose": "PRIMARY_END_TO_END_AGENT_BEHAVIOR_AND_LEDGER_ACCEPTANCE",
      "turns": [
    {
      "turnId": "T01",
      "operation": "read",
      "user": "你好，请读取我 QuickBooks 账户对应公司的名称、本位币、财务年度设置和税务相关设置。",
      "attachments": [],
      "intent": "establish_oauth_bound_target_and_company_context",
      "toolOracle": {
        "required": [
          "quickbooks_connection_status",
          "quickbooks_resolve_target",
          "quickbooks_get_company"
        ],
        "allowed": [],
        "forbidden": [
          "all write tools"
        ]
      },
      "responseOracle": {
        "mustState": [
          "current QuickBooks Company identity",
          "home currency",
          "whether multi-currency is enabled or unknown",
          "which requested fields QuickBooks did not return"
        ],
        "mustNotClaim": [
          "the connection belongs to another user",
          "missing fields were successfully read"
        ]
      }
    },
    {
      "turnId": "T02",
      "operation": "read",
      "user": "检查当前账套是否存在银行账户、客户、供应商、商品项目和历史交易，也看看 bills、税码和 trial balance。不要只看第一页就说整个账套是空的。",
      "attachments": [],
      "intent": "read_ledger_inventory_with_bounded_evidence",
      "toolOracle": {
        "required": [
          "quickbooks_list_accounts",
          "quickbooks_search_customers",
          "quickbooks_search_vendors",
          "quickbooks_list_items",
          "quickbooks_list_bills",
          "quickbooks_list_transactions",
          "quickbooks_list_tax_codes",
          "quickbooks_get_trial_balance"
        ],
        "allowed": [
          "quickbooks_run_report"
        ],
        "forbidden": [
          "all write tools"
        ]
      },
      "responseOracle": {
        "mustState": [
          "query boundaries or pagination limits",
          "page-level absence is not whole-ledger absence"
        ],
        "mustNotClaim": [
          "page 1 empty means the entire ledger is empty",
          "No Tax means tax exempt"
        ]
      }
    },
    {
      "turnId": "T03",
      "operation": "read",
      "user": "总共有十四个文件，我会分两次长传。你先保持这次会话上下文，不要先入账。",
      "attachments": [],
      "intent": "announce_batched_upload",
      "toolOracle": {
        "required": [],
        "allowed": [],
        "forbidden": [
          "all provider calls",
          "all write tools"
        ]
      },
      "responseOracle": {
        "mustState": [
          "will wait for all 14 files",
          "no ledger write has occurred"
        ],
        "mustNotClaim": [
          "all files were received"
        ]
      }
    },
    {
      "turnId": "T04",
      "operation": "read",
      "user": "我上传了前面十个，你先等一下，我将继续上传另外四个。不要因为看到 invoice 就先写。",
      "attachments": [
        "qbo-ra-art-01-customer-master",
        "qbo-ra-art-02-vendor-onboarding",
        "qbo-ra-art-03-inbound-customer-po",
        "qbo-ra-art-04-sales-invoice",
        "qbo-ra-art-05-vendor-bill",
        "qbo-ra-art-06-grn",
        "qbo-ra-art-07-bank-statement",
        "qbo-ra-art-08-remittance-advice",
        "qbo-ra-art-09-sales-credit-memo",
        "qbo-ra-art-10-vendor-credit"
      ],
