{
  "name": "@zcloak/quickbooks-ledger-mcp",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Independent QuickBooks Online ledger MCP with per-user OAuth and governed Accounting Case writes.",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx watch src/quickbooks/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node dist/quickbooks/migrate.js",
    "migrate:dev": "tsx src/quickbooks/migrate.ts",
    "start": "node dist/quickbooks/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:http:required": "TEST_HTTP_LOOPBACK=true vitest run tests/quickbooks-http-app.test.ts",
    "test:postgres:required": "node scripts/requireTestDatabase.mjs && vitest run tests/postgres-quickbooks-mutation.integration.test.ts tests/quickbooks-accounting-case-postgres.integration.test.ts --maxWorkers=1",
    "verify:no-secrets": "node scripts/verifyNoSecrets.mjs",
    "verify:release": "node scripts/verifyReleaseGate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.1.0",
    "pg": "8.16.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
